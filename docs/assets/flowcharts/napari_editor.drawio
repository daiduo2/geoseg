<mxfile host="app.diagrams.net" modified="2026-06-19T00:00:00.000Z" agent="geoseg-docs" etag="napari_editor" version="24.0.0" type="device">
  <diagram name="napari 边界编辑" id="napari_editor">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Agent Bash 启动 napari_app&#xa;传入 labels.npz + panel.png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="load" value="加载原图 + labels + 现有边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="user_edit" value="用户编辑边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tool_line" value="L: 画开放线&#xa;分割两个区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tool_polygon" value="P: 画闭合多边形&#xa;创建独立区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="360" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tool_select" value="S + Delete: 删除边界线&#xa;两侧区域合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tool_direct" value="D: 拖拽顶点&#xa;微调边界形状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="save" value="Ctrl+S 保存 shapes.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="close" value="关闭窗口 → napari 退出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="recompute" value="Agent 根据 shapes.json&#xa;重新计算 labels_edited.npz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="690" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="show" value="Agent 展示更新后的 overlay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="790" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="human_confirm" value="用户确认 / 继续修改" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="890" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="loop_back" value="继续修改 → 重新启动 napari" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
